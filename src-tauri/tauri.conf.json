{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "last-token",
  "version": "0.2.1",
  "identifier": "com.wangmeng.last-token",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Last Token",
        "width": 460,
        "height": 680,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {}
}
